<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Gaux Equalizer @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" rootVolumeOnly="true" hostArchitectures="@ARCHS@"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <os-version min="11.0"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
    </choices-outline>
    <choice id="vst3" title="VST3" description="Plugin VST3 para Ableton Live, FL Studio, Cubase, Studio One, Reaper, Bitwig...">
        <pkg-ref id="com.gaux.equalizer.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit" description="Plugin AU para Logic Pro, GarageBand y Ableton Live.">
        <pkg-ref id="com.gaux.equalizer.au"/>
    </choice>
    <choice id="app" title="App independiente" description="Gaux Equalizer como aplicación, para probarlo sin DAW.">
        <pkg-ref id="com.gaux.equalizer.app"/>
    </choice>
    <pkg-ref id="com.gaux.equalizer.vst3" version="@VERSION@" onConclusion="none">vst3.pkg</pkg-ref>
    <pkg-ref id="com.gaux.equalizer.au" version="@VERSION@" onConclusion="none">au.pkg</pkg-ref>
    <pkg-ref id="com.gaux.equalizer.app" version="@VERSION@" onConclusion="none">app.pkg</pkg-ref>
</installer-gui-script>
